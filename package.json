{
  "name": "portfolio-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:images": "node scripts/generate-image-variants.mjs",
    "build:wasm": "asc assembly/lif.ts --outFile public/lif.wasm --optimize --runtime stub --noAssert --use abort=",
    "build": "npm run build:images && npm run build:wasm && tsc -b && vite build",
    "check": "tsc -b && eslint . && vitest run && node --test scripts/check-audit.node.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "npm run build && node scripts/axe-preview.mjs",
    "audit:review": "node scripts/check-audit.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-vitals": "^6.2.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "Safari >= 16",
    "not dead"
  ],
  "devDependencies": {
    "@axe-core/cli": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@webgpu/types": "^0.1.74",
    "assemblyscript": "^0.28.20",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=10"
  }
}
